{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["cdk.out/**", "coverage/**", "dist/**"]
}
