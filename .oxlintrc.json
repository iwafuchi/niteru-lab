{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["infra/**/*.ts"],
      "rules": {
        "no-new": "off"
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "expect.*", "template.*"] }
        ]
      }
    }
  ],
  "ignorePatterns": ["cdk.out/**", "coverage/**", "dist/**"]
}
