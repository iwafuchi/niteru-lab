{
  "name": "niteru-lab",
  "version": "0.0.0",
  "private": true,
  "description": "フレーズ一致の判定",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit --project integration",
    "floci:up": "docker compose up -d --wait",
    "floci:down": "scripts/floci-down.sh",
    "cdk:local": "scripts/cdk-local.sh",
    "synth": "scripts/cdk-local.sh synth --quiet && tsx scripts/check-synth.ts",
    "check:pins": "tsx scripts/check-pins.ts",
    "lint:shell": "git ls-files -z '*.sh' .lefthookrc | xargs -0 shellcheck",
    "lint:links": "lychee .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:shell && pnpm lint:links && pnpm typecheck && pnpm check:pins && pnpm test && pnpm synth",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "hono": "4.13.18",
    "kuromoji": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@hono/node-server": "2.1.8",
    "@types/kuromoji": "0.1.3",
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
